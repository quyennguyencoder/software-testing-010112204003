              "  if (id && url.includes(\"/guest-cart\")) pm.environment.set(\"guestCartId\", id);",
              "  if (responseData.orderCode) { pm.environment.set(\"createdOrderCode\", responseData.orderCode); pm.environment.set(\"orderCode\", responseData.orderCode); }",
              "}"
