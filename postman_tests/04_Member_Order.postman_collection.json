    {
      "name": "ORD01 - Tao don hang hop le, luu orderId, orderCode",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const testCaseId = \"ORD01\";",
              "const expectedStatusCodes = [200, 201];",
              "const responseTimeThresholdMs = testCaseId === \"H02\" ? 1000 : Number(pm.environment.get(\"responseTimeThresholdMs\") || 3000);",
              "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
              "let json = {}; let responseData = {};",
              "",
              "console.log(`[${testCaseId}] ===== BẮT ĐẦU KIỂM TRA =====`);",
              "console.log(`[${testCaseId}] Phương thức: ${pm.request.method} | URL: ${pm.request.url}`);",
              "console.log(`[${testCaseId}] Mã trạng thái phản hồi: ${pm.response.code}`);",
              "console.log(`[${testCaseId}] Thời gian phản hồi: ${pm.response.responseTime}ms`);",
              "",
              "if (pm.response.text() && contentType.includes(\"application/json\")) {",
              "  json = pm.response.json();",
              "  responseData = json.data || json;",
              "  console.log(`[${testCaseId}] Nội dung phản hồi (JSON): ${JSON.stringify(responseData, null, 2)}`);",
              "} else {",
              "  console.log(`[${testCaseId}] Phản hồi không phải JSON hoặc rỗng. Content-Type: ${contentType}`);",
              "}",
              "",
              "pm.test(`${testCaseId} expected status ${expectedStatusCodes.join(\"/\")}`, () => {",
              "  const passed = expectedStatusCodes.includes(pm.response.code);",
              "  console.log(`[${testCaseId}] Kiểm tra mã trạng thái: ${passed ? \"✅ PASS\" : \"❌ FAIL\"} (nhận được ${pm.response.code}, mong đợi ${expectedStatusCodes.join(\"/\")})`);",
              "  pm.expect(pm.response.code).to.be.oneOf(expectedStatusCodes);",
              "});",
              "",
              "pm.test(`${testCaseId} no server error`, () => {",
              "  const passed = pm.response.code < 500;",
              "  console.log(`[${testCaseId}] Kiểm tra lỗi server: ${passed ? \"✅ PASS\" : \"❌ FAIL\"} (mã ${pm.response.code})`);",
              "  pm.expect(pm.response.code, pm.response.text()).to.be.below(500);",
              "});",
              "",
              "pm.test(`${testCaseId} response time under threshold`, () => {",
              "  const passed = pm.response.responseTime < responseTimeThresholdMs;",
              "  console.log(`[${testCaseId}] Kiểm tra thời gian phản hồi: ${passed ? \"✅ PASS\" : \"❌ FAIL\"} (${pm.response.responseTime}ms / ngưỡng ${responseTimeThresholdMs}ms)`);",
              "  pm.expect(pm.response.responseTime).to.be.below(responseTimeThresholdMs);",
              "});",
              "",
              "pm.test(`${testCaseId} JSON body when present`, () => {",
              "  if (pm.response.text()) {",
              "    const passed = contentType.includes(\"application/json\");",
              "    console.log(`[${testCaseId}] Kiểm tra Content-Type JSON: ${passed ? \"✅ PASS\" : \"❌ FAIL\"} (${contentType})`);",
              "    pm.expect(contentType).to.include(\"application/json\");",
              "  }",
              "});",
              "",
              "if (pm.response.text() && contentType.includes(\"application/json\")) {",
              "  const id = responseData.id || responseData.productId || responseData.orderId || responseData.addressId || responseData.cartItemId || responseData.guestCartId;",
              "  if (responseData.accessToken) {",
              "    const tokenKey = pm.info.requestName.toLowerCase().includes(\"admin\") ? \"adminAccessToken\" : \"accessToken\";",
              "    pm.environment.set(tokenKey, responseData.accessToken);",
              "    console.log(`[${testCaseId}] ✅ Đã lưu ${tokenKey} vào environment.`);",
              "  }",
              "  if (responseData.refreshToken) {",
              "    pm.environment.set(\"refreshToken\", responseData.refreshToken);",
              "    console.log(`[${testCaseId}] ✅ Đã lưu refreshToken vào environment.`);",
              "  }",
              "  if (responseData.user && responseData.user.id) {",
              "    pm.environment.set(\"userId\", responseData.user.id);",
              "    console.log(`[${testCaseId}] ✅ Đã lưu userId: ${responseData.user.id}`);",
              "  }",
              "  if (id) {",
              "    pm.environment.set(\"currentResourceId\", id);",
              "    console.log(`[${testCaseId}] ✅ Đã lưu currentResourceId: ${id}`);",
              "  }",
              "  const url = pm.request.url.toString();",
              "  if (id && url.includes(\"/admin/products\")) { pm.environment.set(\"createdProductId\", id); pm.environment.set(\"productId\", id); console.log(`[${testCaseId}] ✅ Đã lưu productId: ${id}`); }",
              "  if (id && url.includes(\"/admin/categories\")) { pm.environment.set(\"createdCategoryId\", id); pm.environment.set(\"categoryId\", id); console.log(`[${testCaseId}] ✅ Đã lưu categoryId: ${id}`); }",
              "  if (id && url.includes(\"/admin/brands\")) { pm.environment.set(\"createdBrandId\", id); pm.environment.set(\"brandId\", id); console.log(`[${testCaseId}] ✅ Đã lưu brandId: ${id}`); }",
              "  if (id && url.includes(\"/user/addresses\")) { pm.environment.set(\"createdAddressId\", id); pm.environment.set(\"addressId\", id); console.log(`[${testCaseId}] ✅ Đã lưu addressId: ${id}`); }",
              "  if (id && url.includes(\"/orders\")) { pm.environment.set(\"createdOrderId\", id); pm.environment.set(\"orderId\", id); console.log(`[${testCaseId}] ✅ Đã lưu orderId: ${id}`); }",
              "  if (id && url.includes(\"/admin/promotions\")) { pm.environment.set(\"createdPromotionId\", id); pm.environment.set(\"promotionId\", id); console.log(`[${testCaseId}] ✅ Đã lưu promotionId: ${id}`); }",
              "  if (id && url.includes(\"/admin/promotion-templates\")) { pm.environment.set(\"createdPromotionTemplateId\", id); pm.environment.set(\"promotionTemplateId\", id); console.log(`[${testCaseId}] ✅ Đã lưu promotionTemplateId: ${id}`); }",
              "  if (id && url.includes(\"/cart/items\")) { pm.environment.set(\"cartItemId\", id); console.log(`[${testCaseId}] ✅ Đã lưu cartItemId: ${id}`); }",
              "  if (id && url.includes(\"/guest-cart\")) { pm.environment.set(\"guestCartId\", id); console.log(`[${testCaseId}] ✅ Đã lưu guestCartId: ${id}`); }",
              "  if (responseData.orderCode) {",
              "    pm.environment.set(\"createdOrderCode\", responseData.orderCode);",
              "    pm.environment.set(\"orderCode\", responseData.orderCode);",
              "    console.log(`[${testCaseId}] ✅ Đã lưu orderCode: ${responseData.orderCode}`);",
              "  }",
              "}",
              "",
              "console.log(`[${testCaseId}] ===== KẾT THÚC KIỂM TRA =====`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
