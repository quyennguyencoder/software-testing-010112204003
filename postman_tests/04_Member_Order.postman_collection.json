  "item": [
    {
      "name": "User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra chắc chắn API gọi thành công (Status 200)",
              "pm.test(\"Đăng nhập User thành công với mã 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Chỉ parse JSON khi response body không rỗng",
              "var responseBody = pm.response.text();",
              "if (!responseBody || responseBody.trim() === \"\") {",
              "    console.log(\"Lỗi: Response body rỗng (status \" + pm.response.code + \"). Kiểm tra lại thông tin đăng nhập hoặc server.\");",
              "} else {",
              "    // Chuyển phản hồi của Backend thành đối tượng JSON",
              "    var jsonData = pm.response.json();",
              "",
              "    // Tìm đúng đường dẫn đến chỗ giấu Token và lưu lại",
              "    if (jsonData && jsonData.data && jsonData.data.accessToken) {",
              "        var token = jsonData.data.accessToken;",
              "",
              "        // Lưu vào biến \"accessToken\"",
              "        pm.environment.set(\"accessToken\", token);",
              "",
              "        // In ra console để dễ debug trên CI",
              "        console.log(\"Hệ thống đã tự động chộp được Token của User thường: \" + token);",
              "    } else {",
              "        console.log(\"Lỗi: Không tìm thấy accessToken trong phản hồi!\");",
              "    }",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"usernameOrEmail\": \"user\",\r\n  \"password\": \"Password@123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
