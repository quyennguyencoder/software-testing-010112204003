              "  });",
              "  pm.test(`${testCaseId} totalElements is 0`, () => {",
              "    pm.expect(data.totalElements).to.eql(0);",
              "  });",
              "  pm.test(`${testCaseId} totalPages is 0`, () => {",
              "    pm.expect(data.totalPages).to.eql(0);",
              "  });",
              "  pm.test(`${testCaseId} empty flag is true`, () => {",
              "    pm.expect(data.empty).to.be.true;",
              "  });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
